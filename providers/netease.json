{
  "id": "netease",
  "label": "网易云音乐",
  "version": "2026-11-09.1",
  "hosts": ["music.163.com", "163cn.tv", "y.music.163.com"],
  "patterns": ["playlist\\?id=(\\d+)", "#/playlist\\?id=(\\d+)", "/m/playlist\\?id=(\\d+)"],
  "endpoint": "https://music.163.com/api/playlist/detail?id={id}",
  "referer": "https://music.163.com/",
  "probe": {
    "input": "https://music.163.com/playlist?id=3778678",
    "min_tracks": 100
  },
  "auth": {"optional": false},
  "_note": "实测 2026-11-09：/api/playlist/detail 裸调返回全量 200 首，无需登录；/api/playlist/track/all 裸调 404（需加密参数），不要切过去。"
}
